{
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "summary", "findings", "limitations"],
  "properties": {
    "verdict": { "type": "string", "enum": ["clean", "changes_requested"] },
    "summary": { "type": "string" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "severity", "file", "line", "summary", "detail"],
        "properties": {
          "category": { "type": "string", "enum": ["defect", "unavailable_check"] },
          "severity": { "type": "string", "enum": ["blocking", "should_fix"] },
          "file": { "type": ["string", "null"] },
          "line": { "type": ["integer", "null"] },
          "summary": { "type": "string" },
          "detail": { "type": "string" }
        }
      }
    },
    "limitations": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["behavior", "reason", "blocking"],
        "properties": {
          "behavior": { "type": "string" },
          "reason": { "type": "string" },
          "blocking": { "type": "boolean" }
        }
      }
    }
  }
}
