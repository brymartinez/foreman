              "additionalProperties": false,
              "required": [
                "label",
                "description"
              ],
              "properties": {
                "label": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                }
              }
            }
          },
          "recommendation": {
            "type": "string"
          },
          "impactIfWrong": {
            "type": "string"
          }
        }
      }
