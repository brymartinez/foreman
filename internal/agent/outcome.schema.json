{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "summary",
    "nextObjective",
    "prNumber",
    "prUrl",
    "validation",
    "questions",
    "documents",
    "prTitle",
    "prBody",
    "claims",
    "fullSuite"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "checkpoint",
        "pr_opened",
        "review_ready",
        "blocked",
        "failed"
      ]
    },
    "summary": {
      "type": "string"
    },
    "nextObjective": {
      "type": [
        "string",
        "null"
      ]
    },
    "prNumber": {
      "type": [
        "integer",
        "null"
      ]
    },
    "prUrl": {
      "type": [
        "string",
        "null"
      ]
    },
    "validation": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "passed",
          "scope"
        ],
        "properties": {
          "command": {
            "type": "string"
          },
          "passed": {
            "type": "boolean"
          },
          "scope": {
            "type": "string",
            "enum": [
              "focused",
              "full"
            ]
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "issue",
          "context",
          "options",
          "recommendation",
          "impactIfWrong"
        ],
        "properties": {
          "issue": {
            "type": "string"
          },
          "context": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label",
                "description"
              ],
              "properties": {
                "label": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                }
              }
            }
          },
          "recommendation": {
            "type": "string"
          },
          "impactIfWrong": {
            "type": "string"
          }
        }
      }
    },
    "documents": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "prd",
        "plan"
      ],
      "properties": {
        "prd": {
          "type": "string"
        },
        "plan": {
          "type": "string"
        }
      }
    },
    "prTitle": {
      "type": [
        "string",
        "null"
      ]
    },
    "prBody": {
      "type": [
        "string",
        "null"
      ]
    },
    "claims": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criteria",
          "behavior",
          "evidence",
          "check"
        ],
        "properties": {
          "criteria": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "behavior": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "check": {
            "type": "string"
          }
        }
      }
    },
    "fullSuite": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "status",
        "revision",
        "docOnly",
        "explanation"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "run",
            "unavailable"
          ]
        },
        "revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "docOnly": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "evidence"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "evidence": {
                "type": "string"
              }
            }
          }
        },
        "explanation": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
