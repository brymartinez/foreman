    "documents": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "analysis",
        "prd",
        "design",
        "plan"
      ],
      "properties": {
        "analysis": {
          "type": "string"
        },
        "prd": {
          "type": "string"
        },
        "design": {
          "type": "string"
        },
        "plan": {
          "type": "string"
        }
