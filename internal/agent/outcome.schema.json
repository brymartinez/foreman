      "type": "string",
      "enum": [
        "planned",
        "pr_opened",
        "blocked",
        "failed"
      ]
    },
    "summary": {
      "type": "string"
    },
    "prNumber": {
      "type": [
        "integer",
        "null"
      ]
    },
    "prUrl": {
      "type": [
        "string",
        "null"
      ]
    },
    "validation": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "passed"
        ],
        "properties": {
          "command": {
            "type": "string"
          },
          "passed": {
            "type": "boolean"
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "issue",
          "context",
          "options",
          "recommendation",
          "impactIfWrong"
        ],
        "properties": {
          "issue": {
            "type": "string"
          },
          "context": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
