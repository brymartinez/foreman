{
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "summary", "prNumber", "prUrl", "validation", "question"],
  "properties": {
    "status": { "type": "string", "enum": ["pr_opened", "blocked", "failed"] },
    "summary": { "type": "string" },
    "prNumber": { "type": ["integer", "null"] },
    "prUrl": { "type": ["string", "null"] },
    "validation": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "passed"],
        "properties": {
          "command": { "type": "string" },
          "passed": { "type": "boolean" }
        }
      }
    },
    "question": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["issue", "context", "options", "recommendation", "impactIfWrong"],
          "properties": {
            "issue": { "type": "string" },
            "context": { "type": "string" },
            "options": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["label", "description"],
                "properties": {
                  "label": { "type": "string" },
                  "description": { "type": "string" }
                }
              }
            },
            "recommendation": { "type": "string" },
            "impactIfWrong": { "type": "string" }
          }
        }
      ]
    }
  }
}
